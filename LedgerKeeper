    </section>

    <!-- Value Proposition -->
    <section id="about" class="value-prop">
        <div class="container">
            <h2>Why Choose LedgerKeeper?</h2>
            <p style="text-align: center; max-width: 600px; margin: 0 auto;">We replace the complexity of traditional accounting with seamless technology and dedicated human expertise.</p>
            
            <div class="value-grid">
                <div class="value-card">
                    <div class="icon-box">⚡</div>
                    <h3>Save 10+ Hours/Month</h3>
                    <p>Stop drowning in receipts and spreadsheets. We automate transaction logging and categorization.</p>
                </div>
                <div class="value-card">
                    <div class="icon-box">🛡️</div>
                    <h3>100% Tax Ready</h3>
                    <p>Never fear tax season again. Your books are kept perfectly structured and ready for your CPA year-round.</p>
                </div>
                <div class="value-card">
                    <div class="icon-box">📈</div>
